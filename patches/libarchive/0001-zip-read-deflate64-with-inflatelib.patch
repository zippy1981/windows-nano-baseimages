@@ -4566,6 +4709,9 @@ zip_read_mac_metadata(struct archive_read *a, struct archive_entry *entry,
 		}
 #ifdef HAVE_ZLIB_H
 	case 8: /* Deflate compression. */
+#endif
+#ifdef HAVE_INFLATELIB_H
+	case 9: /* Deflate64 compression. */
 #endif
 		break;
 	default: /* Unsupported compression. */
@@ -4677,6 +4823,41 @@ zip_read_mac_metadata(struct archive_read *a, struct archive_entry *entry,
 			mp += zip->stream.total_out;
 			break;
 		}
+#endif
+#ifdef HAVE_INFLATELIB_H
+		case 9: /* Deflate64 compression. */
+		{
+			int r;
+
+			ret = zip_deflate64_init(a, zip);
+			if (ret != ARCHIVE_OK)
+				goto exit_mac_metadata;
+			zip->inflstream.next_in = p;
+			zip->inflstream.avail_in = (size_t)bytes_avail;
+			zip->inflstream.total_in = 0;
+			zip->inflstream.next_out = mp;
+			zip->inflstream.avail_out = (size_t)metadata_bytes;
+			zip->inflstream.total_out = 0;
+
+			r = inflatelib_inflate64(&zip->inflstream);
+			switch (r) {
+			case INFLATELIB_OK:
+				break;
+			case INFLATELIB_EOF:
+				eof = 1;
+				break;
+			default:
+				archive_set_error(&a->archive,
+				    ARCHIVE_ERRNO_MISC,
+				    "ZIP decompression failed (%d)", r);
+				ret = ARCHIVE_FATAL;
+				goto exit_mac_metadata;
+			}
+			bytes_used = (size_t)zip->inflstream.total_in;
+			metadata_bytes -= (size_t)zip->inflstream.total_out;
+			mp += zip->inflstream.total_out;
+			break;
+		}
 #endif
 		default:
 			bytes_used = 0;
